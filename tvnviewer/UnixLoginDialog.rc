#include "UnixLoginResource.h"
#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_DUNIXLOGIN DIALOGEX 0, 0, 246, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tight Unix Login Authentication"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "VNC server:",IDC_STATIC,10,11,54,9
    EDITTEXT        IDC_UNIX_LOGIN_HOST,69,8,167,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Username:",IDC_STATIC,10,36,54,9
    EDITTEXT        IDC_UNIX_LOGIN_USERNAME,69,33,167,14,ES_AUTOHSCROLL
    LTEXT           "Password:",IDC_STATIC,10,59,54,9
    EDITTEXT        IDC_UNIX_LOGIN_PASSWORD,69,56,167,14,ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,130,82,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,186,82,50,14
END
